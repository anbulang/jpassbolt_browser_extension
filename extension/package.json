{
  "name": "jpassbolt-extension",
  "private": true,
  "version": "0.1.0",
  "description": "JPassbolt browser extension — Aegis-styled, Passbolt-compatible E2EE password manager client. Keys and crypto live in the isolated background service worker; the UI never touches private key material.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "zip": "cd dist && zip -r -FS ../jpassbolt-extension.zip . && cd ..",
    "e2e": "node e2e/all.mjs",
    "e2e:mail": "node e2e/mail.mjs"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "lucide-react": "^0.577.0",
    "openpgp": "^6.3.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "beta",
    "@types/chrome": "latest",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.2",
    "typescript": "~5.9.3",
    "vite": "^6.3.5"
  }
}
